# ===== Banco de dados (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=indicadores
DB_PASSWORD=troque_esta_senha
DB_NAME=indicadores_ci

# ===== API (NestJS) =====
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ===== SuperTokens (login) =====
SUPERTOKENS_PORT=3567
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# ===== E-mail (confirmação e redefinição de senha) =====
# EMAIL_SERVICE=(serviço a ser utilizado):
#   mailpit = caixa de teste local; os e-mails aparecem em http://localhost:8025 (padrão)
#   gmail   = conta Gmail: preencha SMTP_USER (gmail) e SMTP_PASSWORD (criar em senhas de app)
#   smtp    = outro provedor: preencha também SMTP_HOST, SMTP_PORT e SMTP_SECURE
EMAIL_SERVICE=mailpit
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAIL_UI_PORT=8025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Indicadores CI"
SMTP_FROM_EMAIL=nao-responda@indicadores-ci.local

# ===== Segurança =====
PASSWORD_BREACH_CHECK=true
RATE_LIMIT_AUTH=30
RATE_LIMIT_GERAL=300
TRUST_PROXY=
COOKIE_DOMAIN=

# ===== Web (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_URL_INTERNAL=http://api:3001
