# ===== Banco de dados (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=indicadores
DB_PASSWORD=troque_esta_senha
DB_NAME=indicadores_ci

# ===== API (NestJS) =====
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ===== SuperTokens (login) =====
SUPERTOKENS_PORT=3567
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# ===== E-mail (confirmação e redefinição) =====
# Desenvolvimento: Mailpit (container do compose). Veja os e-mails em http://localhost:8025
# Produção: use o SMTP de um serviço real (SMTP_SECURE=true na porta 465)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Indicadores CI"
SMTP_FROM_EMAIL=nao-responda@indicadores-ci.local
MAIL_UI_PORT=8025

# ===== Segurança =====
PASSWORD_BREACH_CHECK=true
RATE_LIMIT_AUTH=30
RATE_LIMIT_GERAL=300
TRUST_PROXY=
COOKIE_DOMAIN=

# ===== Web (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_URL_INTERNAL=http://api:3001
